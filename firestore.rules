rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Troque pelo(s) e-mail(s) que podem usar o painel
    function admin() { return request.auth != null && request.auth.token.email in ['SEU@EMAIL.COM', 'EMAIL.DO.NAMORADO@EMAIL.COM']; }
    match /config/{d} { allow read: if true; allow write: if admin(); }
    match /orders/{id} { allow create: if true; allow read, update, delete: if admin(); }
  }
}
